{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carelens.invalid/schema/session/1",
  "title": "CareLens web session export",
  "description": "Estimates and check-in events from one browser session. Wellbeing trends only - not a medical device. No media, no device ids, no free-text device labels. Validated by web/src/export/schema.ts and carelens/websession.py (hand-written, kept in step by tests).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "app_version", "params_version", "started_at", "tz_offset_min", "device", "modes", "estimates", "events", "disclaimer"],
  "properties": {
    "schema_version": { "const": 1 },
    "app_version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "params_version": { "type": "integer", "minimum": 0, "description": "whole-number floats such as 7.0 are accepted (JSON Schema integer)" },
    "started_at": { "type": "string", "description": "ISO 8601 with a UTC offset, e.g. 2026-11-20T10:00:00.000-08:00" },
    "tz_offset_min": { "type": "integer", "minimum": -840, "maximum": 840, "description": "minutes EAST of UTC (matches the offset in started_at)" },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_agent_family"],
      "properties": { "user_agent_family": { "enum": ["Chrome", "Edge", "Firefox", "Safari", "Other"] } }
    },
    "modes": { "type": "array", "uniqueItems": true, "items": { "enum": ["camera", "microphone", "fingertip"] } },
    "estimates": { "type": "array", "items": { "$ref": "#/$defs/estimate" } },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "summaries": { "type": "array", "items": { "$ref": "#/$defs/summary" }, "description": "optional (absent in older exports): whole-measurement results, currently HRV from a fingertip measurement" },
    "disclaimer": { "type": "string", "minLength": 1 },
    "truncated": { "type": "boolean", "description": "true when a per-metric / event row cap was hit and later rows were dropped" }
  },
  "$defs": {
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "wall", "metric", "value", "quality", "reported", "reason"],
      "if": { "properties": { "reported": { "const": true } }, "required": ["reported"] },
      "then": { "properties": { "value": { "type": "number" } } },
      "properties": {
        "t": { "type": "number", "minimum": 0, "description": "seconds since started_at, at the END of the analysed window" },
        "wall": { "type": "string", "description": "ISO 8601 with offset: started_at + t" },
        "metric": { "enum": ["hr_fingertip", "hr_face", "br_camera", "br_sound"] },
        "value": { "type": ["number", "null"], "description": "bpm or breaths/min; null when the estimator withheld a value (such rows still count towards coverage)" },
        "quality": { "type": "number", "minimum": 0, "maximum": 1 },
        "reported": { "type": "boolean", "description": "true when the quality gate let the value be shown" },
        "reason": { "type": "string", "maxLength": 40 },
        "span_s": { "type": "number", "exclusiveMinimum": 0, "description": "analysed window length; the estimate is centred at t - span_s/2" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "wall", "kind", "reported", "reason"],
      "if": { "properties": { "reported": { "const": true } }, "required": ["reported"] },
      "then": { "required": ["rmssd_ms", "sdnn_ms"] },
      "properties": {
        "t": { "type": "number", "minimum": 0, "description": "seconds since started_at when the result was produced" },
        "wall": { "type": "string" },
        "kind": { "enum": ["hrv"] },
        "reported": { "type": "boolean" },
        "reason": { "type": "string", "maxLength": 40, "description": "ok | too_short | low_fps | unsteady | too_many_artifacts" },
        "rmssd_ms": { "type": "number", "minimum": 0 },
        "sdnn_ms": { "type": "number", "minimum": 0 },
        "mean_hr_bpm": { "type": "number", "exclusiveMinimum": 0 },
        "n_beats": { "type": "integer", "minimum": 0 },
        "n_kept": { "type": "integer", "minimum": 0 },
        "kept_frac": { "type": "number", "minimum": 0, "maximum": 1 },
        "duration_s": { "type": "number", "minimum": 0, "description": "length of the continuous-contact segment analysed" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "wall", "kind"],
      "properties": {
        "t": { "type": "number", "minimum": 0, "description": "seconds since started_at when it was raised" },
        "wall": { "type": "string" },
        "kind": { "enum": ["possible_fall", "inactivity", "cough"] },
        "t_onset": { "type": "number", "minimum": 0, "description": "possible_fall / inactivity: estimated onset" },
        "t_end": { "type": "number", "minimum": 0, "description": "cough: end of the sound" },
        "peak_score": { "type": "number", "minimum": 0, "maximum": 1, "description": "cough: classifier peak score" },
        "trigger": { "type": "string", "maxLength": 40 }
      }
    }
  }
}
