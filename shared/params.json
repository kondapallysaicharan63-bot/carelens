{
  "version": 3,
  "description": "Single source of every tunable number used by the CareLens core (Python reference + TypeScript port). Not a medical device.",
  "units": {
    "_s": "seconds",
    "_hz": "hertz",
    "_deg": "degrees",
    "_deg_s": "degrees per second",
    "_px": "pixels",
    "_bodysizes_s": "body sizes per second (landmark speed / body extent)",
    "_frac": "dimensionless fraction",
    "_m": "metres",
    "_bpm": "beats (or breaths) per minute"
  },
  "common": {
    "still_motion_bodysizes_s": 0.08,
    "min_quality": 0.35
  },
  "vitals": {
    "signal": {
      "bandpass_order": 3,
      "bandpass_nyquist_frac": 0.95,
      "welch_min_segment_s": 8.0,
      "welch_segment_cycles": 2.5,
      "welch_nfft_min": 4096,
      "welch_nfft_oversample": 4,
      "peak_window_frac": 0.1,
      "estimator_min_samples": 10,
      "estimator_window_fill_frac": 0.9
    },
    "heart_rate": {
      "window_s": 15.0,
      "step_s": 1.0,
      "band_lo_hz": 0.7,
      "band_hi_hz": 3.0,
      "min_brightness": 40,
      "max_brightness": 230
    },
    "breathing": {
      "window_s": 30.0,
      "step_s": 2.0,
      "band_lo_hz": 0.1,
      "band_hi_hz": 0.5
    },
    "roi": {
      "min_landmark_visibility": 0.5,
      "min_box_px": 4,
      "face_min_eye_distance_px": 6,
      "face_top_eye_to_nose_frac": 0.25,
      "face_half_width_eye_dist": 0.9,
      "face_bottom_below_nose_eye_dist": 0.35,
      "chest_half_width_shoulder_frac": 0.45,
      "chest_half_width_torso_frac": 0.3,
      "chest_center_along_torso_frac": 0.35,
      "chest_half_height_torso_frac": 0.3
    }
  },
  "features": {
    "min_visibility": 0.5,
    "walk_speed_bodysizes_s": 0.25,
    "smooth_s": 1.0,
    "aspect_w_over_h": 1.3333333333333333,
    "lying_torso_angle_deg": 60.0,
    "standing_leg_ratio": 1.2,
    "default_leg_ratio": 1.6
  },
  "events": {
    "fall": {
      "drop_window_s": 0.9,
      "upright_deg": 40,
      "lying_deg": 60,
      "drop_frac": 0.35,
      "min_angle_rate_deg_s": 40.0,
      "hip_drop_min_rate_frac_s": 0.3,
      "still_seconds": 20.0,
      "pending_timeout_s": 120.0
    },
    "inactivity": {
      "seconds": 1800.0
    },
    "gait": {
      "person_height_m": 1.65,
      "min_walk_s": 2.0,
      "gap_s": 0.5
    },
    "timeline": {
      "max_step_s": 1.0
    }
  },
  "tracking": {
    "hold_s": 0.5,
    "enter_s": 0.2,
    "max_jump_frame_heights": 0.25,
    "one_euro_min_cutoff_hz": 1.0,
    "one_euro_beta": 1.0,
    "one_euro_d_cutoff_hz": 1.0,
    "one_euro_filter_default_beta": 0.05
  },
  "pipeline": {
    "clip_pre_s": 5.0,
    "clip_buffer_s": 45.0
  },
  "contact_ppg": {
    "window_s": 10.0,
    "step_s": 1.0,
    "fs_hz": 30.0,
    "max_gap_s": 0.5,
    "min_rate_hz": 10.0,
    "band_lo_hz": 0.7,
    "band_hi_hz": 3.0,
    "taper_stop_lo_hz": 0.5,
    "taper_stop_hi_hz": 3.5,
    "zero_pad_factor": 4,
    "snr_halfwidth_hz": 0.12,
    "harm_halfwidth_hz": 0.12,
    "harm_w2": 0.5,
    "harm_w3": 0.33,
    "pi_lo_pct": 5.0,
    "pi_hi_pct": 95.0,
    "beat_max_bpm": 220.0,
    "min_prom": 0.5,
    "min_ibis": 2,
    "finger_r_min": 90.0,
    "finger_ratio_min": 1.8,
    "finger_dr_max": 6.0,
    "max_clip_frac": 0.25,
    "settle_s": 8.0,
    "min_snr": 3.0,
    "agree_bpm": 5.0,
    "pi_min": 0.1,
    "pi_max": 15.0,
    "q_snr_full_db": 15.0,
    "q_pi_full_lo": 0.4,
    "q_pi_full_hi": 5.0,
    "q_w_snr": 0.5,
    "q_w_agree": 0.3,
    "q_w_pi": 0.2
  },
  "rppg": {
    "reserved": true,
    "band_lo_hz": 0.7,
    "band_hi_hz": 3.0,
    "methods": ["POS", "CHROM"]
  },
  "breathing_signal": {
    "reserved": true,
    "band_lo_hz": 0.1,
    "band_hi_hz": 0.7
  },
  "tremor": {
    "reserved": true,
    "band_lo_hz": 3.0,
    "band_hi_hz": 12.0
  },
  "audio": {
    "reserved": true,
    "classifier": "YAMNet",
    "labels": ["Cough", "Snoring", "Screaming", "Crying, sobbing", "Glass", "Thump, thud"]
  }
}
